#sidebar {
    width: 36;
    max-width: 45%;
    border-right: vkey $foreground 20%;
}

#filter {
    margin: 0 1;
}

#tree {
    padding: 0 1;
}

#tabs {
    width: 1fr;
    height: 1fr;
}

#tabs TabPane {
    padding: 0;
}

#main {
    padding: 1 2;
}

QueryPanel {
    height: 1fr;
}

#editor {
    height: 10;
}

#suggestions {
    display: none;
    height: auto;
    max-height: 9;
    border: tall $accent;
    margin: 0 1;
}

#hints, #status, #pager {
    height: auto;
    padding: 0 1;
}

#hints {
    color: $text-muted;
    min-height: 2;
}

#result-bar {
    height: 1;
    margin: 1 0 0 0;
}

#search {
    width: 1fr;
    margin: 0 1;
}

#page-size {
    width: 16;
}

#grid {
    height: 1fr;
}

#cell-value {
    height: auto;
    max-height: 30;
}

ModalScreen {
    align: center middle;
}

.dialog {
    width: 84;
    max-width: 100%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

.dialog.small {
    width: 60;
}

.dialog .title {
    text-style: bold;
    margin-bottom: 1;
}

.dialog .hint {
    color: $text-muted;
    margin-top: 1;
}

.dialog .error {
    color: $error;
}

.dialog OptionList {
    height: auto;
    max-height: 20;
    border: none;
}

.dialog .row {
    height: auto;
    margin-bottom: 1;
}

.dialog .field-label {
    width: 11;
}

.dialog .row Input,
.dialog .row Select {
    width: 1fr;
}

.dialog .buttons {
    height: auto;
    margin-top: 1;
}

.dialog .buttons Button {
    margin-right: 1;
}

.dialog.record {
    width: 110;
    height: 85%;
    max-height: 85%;
}

#record {
    height: 1fr;
}
